#!/usr/bin/env bash
# Bare-repository hook on the host: installed by deploy/bootstrap.sh as ~/space-ops.git/hooks/post-receive.
# The app directory is a clone whose origin is this bare repository (cloned on the first push). After a
# fetch, `space app deploy` resets it to origin/main, runs space.yaml's deploy commands (bun install,
# type check, tests) and restarts the service only when all of them pass, waiting for /healthz; on a
# failure the previous tree goes back and the running service is left alone (ai-space docs/app-spec.md#deploy).
set -euo pipefail
export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
unset GIT_DIR GIT_WORK_TREE
APP=space-ops
WS=${SPACE_HOME:-$HOME/.ai-space}
BARE="$HOME/$APP.git"
WORK="$WS/apps/$APP"

if [[ ! -d "$WORK/.git" ]]; then
  [[ ! -e "$WORK" ]] || { echo 'Refusing to replace an existing non-Git deployment'; exit 1; }
  git clone -q --branch main "$BARE" "$WORK"
else
  [[ "$(git -C "$WORK" remote get-url origin)" == "$BARE" ]] || { echo 'Unexpected deployment origin'; exit 1; }
  git -C "$WORK" fetch -q origin main
fi
if [[ ! -f "$WORK/.env" ]]; then
  WORK="$WORK" bun -e 'const f=await Bun.file(process.env.HOME+"/.ai-space/.env").text(); const name=f.match(/^SPACE_NAME=(.*)$/m)?.[1]?.replace(/^["\x27]|["\x27]$/g,"") || (await import("node:os")).hostname(); await Bun.write(process.env.WORK+"/.env", "SPACE_NAME="+name+"\n");'
  chmod 600 "$WORK/.env"
fi
exec space app deploy "$APP" --rev origin/main
